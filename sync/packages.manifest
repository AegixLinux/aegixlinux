# aegix-sync packages.manifest — TAGS\tNAME[\tURL][\t"desc"]
barbs,rootfs	xorg-server	"is the graphical server, at least until suckless runs on wayland"
barbs,rootfs	xorg-xinit	"starts X"
barbs,rootfs	xorg-xrandr	"is required for multi-monitor management and autorandr"
barbs,rootfs	xorg-xsetroot	"is used by dwm for setting the root window name (status bar)"
barbs,rootfs	xorg-xprop	"is a tool for detecting window properties"
barbs,rootfs	xorg-xwininfo	"allows querying information about windows"
barbs,rootfs	xorg-xbacklight	"enables changing screen brightness levels"
barbs,rootfs	xorg-setxkbmap	"sets keyboard layout in X11"
barbs,rootfs	xorg-xrdb	"loads X resources from xresources file"
barbs,rootfs	xorg-xset	"sets key repeat rate and other X user preferences (used by remaps)"
barbs,rootfs	xclip	"allows for copying and pasting from the command line"
barbs,rootfs	xdotool	"provides window action utilities on the command line"
barbs,rootfs	xwallpaper	"sets the wallpaper"
barbs,rootfs	xcompmgr	"is for transparency and removing screen-tearing"
barbs,rootfs	arandr	"deals with multiple monitor setups nicely"
barbs,rootfs	autorandr	"auto-detects and applies monitor configurations"
barbs	capitaine-cursors	"is the cursor theme used by Aegix"
barbs,rootfs	zsh	"is the default interactive shell"
barbs,rootfs	zsh-completions	"provides additional completion definitions for zsh"
barbs,rootfs	neovim	"neo vim"
barbs,rootfs	vim	"is the classic text editor"
rootfs	nnn
barbs,rootfs	pcmanfm	"alternative gui file manager"
barbs,rootfs	ueberzug	"enables previews in the lf file manager"
barbs,rootfs	pipewire	"is the modern audio/video server"
barbs,rootfs	wireplumber	"is a nice audio system"
barbs,rootfs	pipewire-pulse	"gives pipewire compatibility with PulseAudio programs"
barbs,rootfs	pulsemixer	"is an audio controller"
barbs,rootfs	alsa-utils	"provides amixer and alsamixer for audio control"
barbs,rootfs	pipewire-alsa	"bridges pipewire to ALSA audio devices"
barbs,rootfs	rtkit	"provides realtime scheduling for pipewire audio"
barbs,rootfs	mpd	"is music daemon"
barbs,rootfs	mpc	"is a terminal interface for mpd"
barbs,rootfs	mpv	"is a choice video player"
barbs,rootfs	sxiv	"is a minimalist image viewer"
barbs,rootfs	ffmpeg	"does wonders with audio and video"
barbs,rootfs	ffmpegthumbnailer	"creates video file thumbnail previews"
barbs,rootfs	yt-dlp	"can download any YouTube video (or playlist or channel) when given the link"
barbs,rootfs	zathura	"is a pdf viewer with vim-like bindings"
barbs,rootfs	zathura-pdf-mupdf	"allows mupdf pdf compatibility in zathura"
barbs,rootfs	poppler	"manipulates .pdfs and gives .pdf previews and other .pdf functions"
barbs,rootfs	dunst	"suckless system notifications"
barbs,rootfs	libnotify	"allows desktop notifications"
barbs,rootfs	rofi	"is an application launcher used by dmenu-master and other Aegix scripts"
barbs,rootfs	unclutter	"hides an inactive mouse"
barbs,rootfs	slock	"allows you to lock your computer, and quickly unlock with your password"
barbs	ttf-linux-libertine	"provides the sans and serif fonts for BARBS"
barbs,rootfs	ttf-font-awesome	"provides extended glyph support"
barbs,rootfs	ttf-dejavu	"properly displays emojis."
barbs,rootfs	noto-fonts	"is an expansive font package"
barbs,rootfs	noto-fonts-emoji	"is an emoji font"
barbs,rootfs	gnome-keyring	"is the system keyring"
barbs,rootfs	git	"is the version control system, required by barbs for suckless builds"
barbs,rootfs	rsync	"is a nice way to move files around"
barbs,rootfs	wget	"is a network downloader used by many scripts"
barbs,rootfs	bc	"is a gnu calculator"
barbs,rootfs	fzf	"is a fuzzy finder tool"
barbs,rootfs	bat	"can highlight code output and display files"
barbs,rootfs	htop	"is an interactive process viewer"
barbs,rootfs	man-db	"read manual pages"
rootfs	man-pages
barbs,rootfs	atool	"manages and gives information about archives"
barbs,rootfs	unzip	"unzips zips"
barbs,rootfs	mediainfo	"shows audio and video information"
barbs,rootfs	socat	"is a utility which establishes two byte streams and transfers data between them"
barbs,rootfs	moreutils	"is a collection of useful unix tools"
barbs,rootfs	brightnessctl	"works when xbacklight fails"
barbs,rootfs	dosfstools	"allows your computer to access dos-like filesystems"
barbs,rootfs	ntfs-3g	"allows accessing NTFS partitions"
rootfs	openresolv
barbs,rootfs	maim	"can take quick screenshots at your request"
barbs	xcape	"gives the special escape/super mappings of BARBS"
barbs,rootfs	polkit	"manages user policies"
barbs,rootfs	espeak-ng	"is a text-to-speech synthesizer used by fitter-happier for vintage robotic voice"
barbs,rootfs	gocryptfs	"so CypherText Alcove works by default"
barbs,rootfs	lynx	"is a terminal browser"
barbs,rootfs	newsboat	"is a terminal RSS client"
barbs,rootfs	artix-archlinux-support	"enables access to Arch Linux repositories"
barbs,rootfs	vulkan-radeon	"provides Vulkan driver for AMD GPUs"
barbs,rootfs	mesa-utils	"provides glxinfo and other GL diagnostic tools"
barbs,rootfs-init	networkmanager-runit	"is the runit service for NetworkManager"
barbs,rootfs-init	openssh-runit	"is the runit service for sshd"
barbs,rootfs-init	elogind-runit	"is the runit service for elogind"
rootfs-init	dbus-runit
barbs,rootfs-init	cronie-runit	"is the runit service for cronie"
