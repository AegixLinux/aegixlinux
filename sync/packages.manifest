git	dmenu	https://github.com/aegixlinux/dmenu.git	"runs commands and provides a UI for selection"
git	st	https://github.com/aegixlinux/st.git	"is a custom aegixlinux build of suckless's terminal emulator"
git	dwm	https://github.com/aegixlinux/dwm.git	"is the window manager"
aur	mutt-wizard-git	"is a light-weight terminal-based email system"
aur	python-pywal16	"matches background image colors to system colors"
