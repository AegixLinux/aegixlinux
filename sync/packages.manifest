livefs	intel-ucode
livefs	artix-grub-live
livefs	mkinitcpio-nfs-utils
livefs	squashfs-tools
livefs	gparted
livefs-init	artix-live-runit
aur	gtk-theme-arc-gruvbox-git	"gives the dark GTK theme used in BARBS"
aur	lf-git	"is the default file manager running in the shell"
barbs	exfatprogs	"allows management of exFAT drives"
barbs	python-qdarkstyle	"provides a dark Qt theme"
barbs	ncmpcpp	"a ncurses interface for music with multiple formats and a powerful tag editor"
aur	brave-bin	"is the browser we like best if we are being honest"
aur	abook	"is an offline addressbook usable by neomutt"
aur	zsh-fast-syntax-highlighting-git	"provides syntax highlighting in the shell"
aur	task-spooler	"queues commands or files for download"
aur	simple-mtpfs	"enables the mounting of cell phones"
