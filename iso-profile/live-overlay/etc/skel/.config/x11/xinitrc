#!/bin/sh

# this file is symlinked from ~/.xinitrc

if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xprofile" ]; then
	. "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xprofile"
else
	. "$HOME/.xprofile"
fi

xset s off
xset -dpms
xset s noblank

# Bluetooth agent: runs headless (no tray). It handles pairing prompts and
# auto-connect; the visible status lives in the bar via sb-bluetooth.
command -v blueman-applet >/dev/null 2>&1 && blueman-applet &

ssh-agent dwm
