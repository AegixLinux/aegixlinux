#!/bin/sh

# this file is symlinked from ~/.xinitrc

if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xprofile" ]; then
	. "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xprofile"
else
	. "$HOME/.xprofile"
fi

xset s off
xset -dpms
xset s noblank

# System tray (dwm has none) + Bluetooth applet. Both are optional: on a
# system without them installed these lines are no-ops.
command -v aegix-tray >/dev/null 2>&1 && aegix-tray &
command -v blueman-applet >/dev/null 2>&1 && blueman-applet &

ssh-agent dwm
