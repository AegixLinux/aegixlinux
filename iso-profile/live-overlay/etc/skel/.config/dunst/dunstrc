[global]
    monitor = 0
    follow = keyboard
    width = 350
    height = (0, 300)
    offset = (10, 30)
    padding = 10
    horizontal_padding = 12
    transparency = 10
    font = Monospace 10
    format = "<b>%s</b>\n%b"
    frame_width = 1
    frame_color = "#333333"
    corner_radius = 4

[urgency_low]
    background = "#0a0a0a"
    foreground = "#888888"
    timeout = 3

[urgency_normal]
    background = "#0a0a0a"
    foreground = "#cccccc"
    timeout = 5

[urgency_critical]
    background = "#0a0a0a"
    foreground = "#ff5555"
    frame_color = "#ff5555"
    timeout = 10
