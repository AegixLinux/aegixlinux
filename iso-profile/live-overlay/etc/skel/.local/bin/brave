#!/bin/sh
# Faster Brave startup for X11

# Rename downloads that arrive with spaces in the filename (covers the
# Print -> "Save as PDF" flow, which no download-item hook can see).
# The watcher lives and dies with the browser; its own lock keeps a second
# window from starting a second copy.
if command -v hyphenate-downloads-watch >/dev/null 2>&1; then
    hyphenate-downloads-watch &
    watcher=$!
    trap 'kill "$watcher" 2>/dev/null' EXIT INT TERM
fi

/opt/brave-bin/brave \
    --ozone-platform=x11 \
    --disable-gpu-compositing \
    --disable-smooth-scrolling \
    --disable-features=TranslateUI \
    "$@"
